# ---- FTP Server ----
FTP_HOST=jct.fortidyndns.com
# sftp | ftp | ftps  (ดูใน WinSCP > Session > File protocol)
FTP_PROTOCOL=sftp
# เว้น 0 = ใช้ค่ามาตรฐาน (SFTP 22 / FTP 21)
FTP_PORT=0
FTP_DEFAULT_USER=Mpi
FTP_START_DIR=/PO

# ---- Web ----
PORT=8080
SECRET_KEY=change-me-to-a-long-random-string
ALLOW_UPLOAD=true
ALLOW_DELETE=false

# ---- ใช้งานผ่าน Cloudflare Tunnel ----
# true = อยู่หลัง Cloudflare (เปิด HTTPS cookie + ProxyFix)
BEHIND_PROXY=false
# 127.0.0.1 = รับเฉพาะในเครื่อง (ให้ cloudflared เป็นทางเข้าเดียว)
HOST=0.0.0.0
